    "server":   "node server.js",
    "dev":      "node --watch server.js"
  },
  "dependencies": {
    "dotenv":      "^16.4.5",
    "express":     "^4.18.3",
    "googleapis":  "^144.0.0",
    "twilio":      "^5.3.3"
  }
}
