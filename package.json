{
  "name": "shanvox-dialer",
  "version": "1.0.0",
  "description": "Outbound dialer backend for Shanvox VAPI agent",
  "type": "module",
  "scripts": {
    "setup":    "node setup-sheet.js",
    "dial":     "node dialer.js",
