# ─── VAPI ────────────────────────────────────────────────────
VAPI_API_KEY=your_vapi_api_key
VAPI_ASSISTANT_ID=your_assistant_id        # Dashboard → Assistants → copy ID
VAPI_PHONE_NUMBER_ID=your_phone_number_id  # Dashboard → Phone Numbers → copy ID

# ─── GOOGLE ──────────────────────────────────────────────────
GOOGLE_CLIENT_EMAIL=your-sa@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=your_sheet_id_from_url
GOOGLE_SHEET_NAME=Leads

# ─── DIALER TUNING ───────────────────────────────────────────
MAX_CALLS_PER_RUN=20       # max calls per dialer.js run
DELAY_BETWEEN_MS=8000      # ms gap between calls (8 seconds)
MAX_RETRIES=2              # retry failed/no-answer calls this many times
RETRY_AFTER_HOURS=4        # wait this many hours before retrying

# ─── ALERTS (optional) ───────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
OWNER_WHATSAPP=+91XXXXXXXXXX   # WhatsApp number for urgent alerts
TWILIO_ACCOUNT_SID=ACxxxxxxxx
TWILIO_AUTH_TOKEN=your_token
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# ─── SERVER ──────────────────────────────────────────────────
PORT=3000
