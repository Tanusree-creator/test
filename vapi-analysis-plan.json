{
  "analysisPlan": {
    "summaryPrompt": "Summarize this outbound sales call in 2-3 sentences. Include: caller's interest level, what Shanvox service they need, what was agreed (booked/callback/not interested), and any urgent issues raised.",

    "structuredDataSchema": {
      "type": "object",
      "properties": {
        "callerName":     { "type": "string" },
        "callerCompany":  { "type": "string" },
        "callerGoal":     { "type": "string", "description": "What they want to achieve" },
        "serviceInterest": {
          "type": "string",
          "enum": ["website", "social_media", "paid_ads", "seo", "content", "branding", "multiple", "unsure", "none"]
        },
        "callOutcome": {
          "type": "string",
          "enum": [
            "appointment_booked",
            "lead_saved",
            "urgent_escalated",
            "transferred",
            "callback_requested",
            "not_interested",
            "inquiry_only",
            "no_action",
            "voicemail"
          ]
        },
        "callbackTime":     { "type": "string", "description": "When they want a callback if requested" },
        "urgencyDetected":  { "type": "boolean" },
        "followUpRequired": { "type": "boolean" },
        "callerPhone":      { "type": "string" }
      }
    }
  }
}
